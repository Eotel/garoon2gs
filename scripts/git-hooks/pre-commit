#!/bin/sh

set -eu

echo "Running pre-commit hook..."

echo "Formatting Go code..."
go fmt ./...

echo "Running go vet..."
go vet ./...

if command -v golangci-lint >/dev/null 2>&1; then
  echo "Running golangci-lint..."
  golangci-lint run
else
  echo "golangci-lint not found. Skipping."
fi

if git diff --quiet -- '*.go'; then
  echo "No formatting changes to stage."
else
  echo "Staging formatted Go files..."
  git diff --name-only -- '*.go' | while IFS= read -r file; do
    [ -n "$file" ] && git add "$file"
  done
fi

echo "Pre-commit hook finished successfully"
